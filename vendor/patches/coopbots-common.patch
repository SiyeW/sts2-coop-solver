index 0000000000000000000000000000000000000000..d7474841571f9c3201bbcc4a5d85a09918429b4c
--- /dev/null
+++ b/src/CoopBots.Kernel/KernelSession.Potions.cs
@@ -0,0 +1,315 @@
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Entities.Potions;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Potions;
+using CoopBots.Kernel.Vendor;
+using CoopBots.Kernel.Vendor.Engine.Common;
+using CoopBots.Kernel.Vendor.Engine.InCombat.Simulation;
+using CoopBots.Kernel.Vendor.Engine.InCombat.Mirrors.Potions.OnUse;
+
+namespace CoopBots.Kernel;
+
+public sealed partial class KernelSession
+{
+    private sealed record PotionInventory(int Capacity, bool CanUse, PotionModel[] Originals,
+        HashSet<PotionModel> Usable);
+
+    // Frozen at live capture time and shared by every fork. Simulated slot contents
+    // still belong to the fork and are checked by physical bottle identity.
+    private sealed record PotionSnapshot(
+        IReadOnlyDictionary<PotionModel, (int Slot, PotionModel Captured)> Slots,
+        IReadOnlyDictionary<Player, PotionInventory> Inventories,
+        IReadOnlyDictionary<PotionModel, IReadOnlyDictionary<string, decimal>> Values,
+        IReadOnlyDictionary<PotionModel, IReadOnlyDictionary<Creature, bool>> TargetRules)
+    {
+        internal static readonly PotionSnapshot Empty = new(
+            new Dictionary<PotionModel, (int, PotionModel)>(),
+            new Dictionary<Player, PotionInventory>(),
+            new Dictionary<PotionModel, IReadOnlyDictionary<string, decimal>>(),
+            new Dictionary<PotionModel, IReadOnlyDictionary<Creature, bool>>());
+    }
+
+    private PotionSnapshot potionSnapshot = PotionSnapshot.Empty;
+
+    private static PotionSnapshot CapturePotions(CombatState live, SimulatedCombatState combat)
+    {
+        var slots = live.Players.SelectMany(player => Enumerable.Range(0, player.PotionSlots.Count)
+            .Where(slot => player.GetPotionAtSlotIndex(slot) is not null)
+            .Select(slot => (Original: player.GetPotionAtSlotIndex(slot)!, Slot: slot,
+                Captured: combat.GetPotionAtSlot(player, slot)!)))
+            .ToDictionary(row => row.Original, row => (row.Slot, row.Captured));
+
+        var inventories = live.Players.ToDictionary(player => player, player =>
+        {
+            var originals = player.Potions.ToArray();
+            return new PotionInventory(player.MaxPotionCount, player.CanUseOrRemovePotions, originals,
+                originals.Where(p => !p.IsQueued && !p.HasBeenRemovedFromState && p.PassesCustomUsabilityCheck
+                    && p.Usage is PotionUsage.CombatOnly or PotionUsage.AnyTime).ToHashSet());
+        });
+
+        var values = slots.Keys.ToDictionary(p => p,
+            p => (IReadOnlyDictionary<string, decimal>)p.DynamicVars.Values.ToDictionary(v => v.Name, v => v.BaseValue));
+        var targets = slots.Keys.ToDictionary(p => p,
+            p => (IReadOnlyDictionary<Creature, bool>)live.Creatures.ToDictionary(c => c, p.IsValidTarget));
+        return new(slots, inventories, values, targets);
+    }
+
+    private PotionModel? FindCapturedPotion(PotionModel original) => FindCapturedPotion(original, out _);
+
+    private PotionModel? FindCapturedPotion(PotionModel original, out int slot)
+    {
+        var captured = original;
+        if (potionSnapshot.Slots.TryGetValue(original, out var entry))
+            (slot, captured) = entry;
+        else
+            slot = GeneratedPotionSlot(original);
+
+        if (captured is not null && slot >= 0 && ReferenceEquals(Combat.GetPotionAtSlot(original.Owner, slot), captured))
+            return captured;
+        slot = -1;
+        return null;
+    }
+
+    internal int RecordedPotionSlot(PotionModel potion)
+        => potionSnapshot.Slots.TryGetValue(potion, out var entry) ? entry.Slot : GeneratedPotionSlot(potion);
+
+    internal static int GeneratedPotionSlot(PotionModel potion) => SimulatedCombatState.GeneratedPotionSlot(potion);
+
+    internal PotionModel? PotionAtSlot(Player player, int slot)
+    {
+        var potion = Combat.GetPotionAtSlot(player, slot);
+        if (potion is null || !potionSnapshot.Inventories.TryGetValue(player, out var inventory)) return null;
+        foreach (var original in inventory.Originals)
+            if (potionSnapshot.Slots.TryGetValue(original, out var entry) &&
+                entry.Slot == slot && ReferenceEquals(entry.Captured, potion))
+                return original;
+        return GeneratedPotionSlot(potion) == slot ? potion : null;
+    }
+
+    public int PotionCapacity(Player player) => potionSnapshot.Inventories.TryGetValue(player, out var inventory) ? inventory.Capacity : 0;
+    public bool CanUsePotions(Player player) => potionSnapshot.Inventories.TryGetValue(player, out var inventory) && inventory.CanUse;
+    internal IReadOnlyList<PotionModel> CapturedPotions(Player player)
+        => potionSnapshot.Inventories.TryGetValue(player, out var inventory) ? inventory.Originals : [];
+    internal decimal PotionValue(PotionModel potion, string variable)
+        => potionSnapshot.Values.TryGetValue(potion, out var values) && values.TryGetValue(variable, out var value)?value:
+            GeneratedPotionSlot(potion)>=0 && potion.DynamicVars.TryGetValue(variable,out var generated)
+                ?generated.BaseValue:0;
+    public int HeldPotionCount(Player player) => Enumerable.Range(0, PotionCapacity(player))
+        .Count(slot => Combat.GetPotionAtSlot(player, slot) is not null);
+    public bool HoldsPotion(PotionModel potion) => FindCapturedPotion(potion) is not null;
+    public IReadOnlyList<PotionModel> UsablePotions(Player player)
+    {
+        if(!potionSnapshot.Inventories.TryGetValue(player,out var inventory))return [];
+        var potions=new List<PotionModel>(inventory.Originals.Length);
+        for(int slot=0;slot<inventory.Capacity;slot++)
+        {
+            if(PotionAtSlot(player,slot) is not {} potion)continue;
+            if(inventory.Usable.Contains(potion) || inventory.CanUse && GeneratedPotionSlot(potion)>=0 &&
+                potion.GetType().Assembly==typeof(PotionModel).Assembly &&
+                potion.Usage is PotionUsage.CombatOnly or PotionUsage.AnyTime)
+                potions.Add(potion);
+        }
+        return potions;
+    }
+    /// <summary>
+    /// Whether the built-in kernel can replay this bottle, including its selection contract.
+    /// </summary>
+    public static bool CanModelPotion(PotionModel potion)
+        => RequiresPotionChoiceContract(potion)
+            || PotionOnUseMirrors.CanMirror(potion) && !PotionChoiceSupport.RequiresChoice(potion);
+
+    public IReadOnlyList<Creature?> PotionTargets(PotionModel potion)
+    {
+        bool generated=GeneratedPotionSlot(potion)>=0;
+        bool Allowed(Creature target)
+        {
+            if(generated)return Hp(target)>0;
+            // Native target rules may read IsAlive. Freeze their answers for
+            // native identities on Capture's thread; later summons are private
+            // simulated creatures and can still use the native rule directly.
+            if (potionSnapshot.TargetRules.TryGetValue(potion, out var targets) && targets.TryGetValue(target, out var allowed))
+                return allowed;
+            return potion.IsValidTarget(target);
+        }
+        switch (generated && potion is FoulPotion?TargetType.AllEnemies:potion.TargetType)
+        {
+            case TargetType.AllEnemies:
+                return [null];
+            case TargetType.AnyEnemy:
+                return Enemies.Where(Allowed).Cast<Creature?>().ToArray();
+            case TargetType.AnyPlayer:
+                return Combat.Players.Where(p => Hp(p.Creature) > 0 && Allowed(p.Creature))
+                    .Select(p => (Creature?)p.Creature).ToArray();
+            case TargetType.Self:
+                return Hp(potion.Owner.Creature) > 0 ? [potion.Owner.Creature] : [];
+            default:
+                return [];
+        }
+    }
+
+    /// <summary>
+    /// Uses a potion inside this branch. Potions are free actions, so a potion
+    /// that turns a non-lethal turn into a confirmed kill can be evaluated and
+    /// confirmed by the same engine that plans the cards.
+    /// </summary>
+    public bool UsePotion(PotionModel potion, Creature? target, out string boundary)
+    {
+        if (potion is DistilledChaos)
+        {
+            choiceOrdinals = [];
+            choicePosition = 0;
+        }
+        return UsePotion(potion, target, null, out boundary);
+    }
+
+    private bool UsePotion(PotionModel potion, Creature? target, IReadOnlyList<KernelChoice>? choices, out string boundary)
+    {
+        LastTurnStartChoices = null;
+        if (RequiresPotionChoiceContract(potion)) return UseTouch(potion, target, choices, out boundary);
+        if (SupportsPotionSelection(potion) && (choices is { Count: > 0 } || MenuSelector is not null))
+            return UseSelectedPotion(potion, target, choices, out boundary);
+        using var isolation = SimulationNotificationIsolation.Enter();
+        if (failedBoundary is not null) { boundary = failedBoundary; return false; }
+        if (!CanAct(potion.Owner)) { boundary = "owner-ended"; return false; }
+        // A host can supply choice support before entering the built-in potion lifecycle.
+        if (PotionChoiceSupport.RequiresChoice(potion))
+        { boundary = "potion-choice-unmodeled"; return false; }
+        failedBoundary = "incomplete-action";
+        try
+        {
+            var simulated = FindCapturedPotion(potion, out int slot);
+            if (simulated is null)
+            { boundary = failedBoundary = "potion-not-captured"; return false; }
+
+            var potionHistoryStart = simulator.History.Entries.Count;
+            Combat.BeginActionChoices(ChoiceCursor(potion.Owner));
+            try
+            {
+                if (!PotionExecutionSupport.Prepare(simulator, Combat, simulated, slot, target)
+                    || !PotionExecutionSupport.Complete(simulator, Combat, simulated, target, null,
+                        potionHistoryStart, processedDeaths))
+                { boundary = failedBoundary = "pending-choice"; return false; }
+                if (!CombatBeamSolver.SettleReplayActionBoundary(simulator, Combat))
+                { boundary = failedBoundary = "pending-boundary"; return false; }
+            }
+            finally { Combat.EndActionChoices(); }
+            simulator.CheckWinCondition(Combat.GetPlayerTurnNumber(potion.Owner));
+        }
+        catch (Exception error)
+        {
+            boundary = failedBoundary = "potion-exception:" + error.GetType().Name;
+            return false;
+        }
+        return FinishActionEvidence("OnUse", potion.Id.Entry, out boundary);
+    }
+
+    /// <summary>Whether a recorded player selection can complete this potion.</summary>
+    public static bool SupportsPotionSelection(PotionModel potion)
+        => potion is GamblersBrew or Ashwater or DropletOfPrecognition or LiquidMemories
+            || PotionChoiceSupport.GeneratesCardChoice(potion);
+
+    private bool UseSelectedPotion(PotionModel potion, Creature? target,
+        IReadOnlyList<KernelChoice>? choices, out string reason)
+    {
+        var owner = potion.Owner;
+        var recipient = target?.Player;
+        if (!CanFork || !CanAct(owner) || recipient is null ||
+            !Party.Contains(recipient) || !potion.IsValidTarget(target) ||
+            Hp(recipient.Creature) <= 0 || FindCapturedPotion(potion, out int slot) is not { } native)
+        {
+            reason = "药水或目标已变化";
+            return false;
+        }
+        using var isolation = SimulationNotificationIsolation.Enter();
+        int history = simulator.History.Entries.Count;
+        failedBoundary = "incomplete-action";
+        try
+        {
+            Combat.BeginActionChoices(ChoiceCursor(owner));
+            try
+            {
+                if(!PotionExecutionSupport.Prepare(simulator, Combat, native, slot, target))
+                {reason=failedBoundary="药水选牌前未结算";return false;}
+                var spec = BuildPotionMenu(simulator, native, recipient);
+                var request=new TurnStartChoiceRequest(potion.Id.Entry,spec.Effect,spec.SourcePile,spec.MaxCount,spec,MenuSource:potion.Id.Entry);
+                var selected = MenuSelector?.Invoke(request, recipient, KernelMenuKind.Potion);
+                var cards=selected!=null?
+                    TurnStartChoiceSupport.ResolveTokens(selected,spec.Options,
+                        Math.Min(spec.MinCount,spec.Options.Count),Math.Min(spec.MaxCount,spec.Options.Count)):
+                    ResolveRecorded(choices,spec,recipient,potion.Id.Entry);
+                if(cards==null){reason=failedBoundary="药水选牌与记录不一致";return false;}
+                if(!ApplyPotionSelection(simulator, Combat, owner, spec.Effect, cards) ||
+                    !PotionExecutionSupport.Complete(simulator, Combat, native, target, null, history, processedDeaths) ||
+                    !CombatBeamSolver.SettleReplayActionBoundary(simulator, Combat))
+                {reason=failedBoundary="药水选牌或结算与记录不一致";return false;}
+            }
+            finally{Combat.EndActionChoices();}
+            simulator.CheckWinCondition(Combat.GetPlayerTurnNumber(owner));
+            return FinishActionEvidence("OnUse", potion.Id.Entry, out reason);
+        }
+        catch(Exception error) when(error is InvalidOperationException or ArgumentException or NotSupportedException)
+        {reason=failedBoundary="药水选牌："+error.GetBaseException().Message;return false;}
+    }
+
+    private static CardChoiceSpec BuildPotionMenu(CombatPredictionSimulator simulator,PotionModel potion,Player recipient)
+    {
+        if(PotionChoiceSupport.GeneratesCardChoice(potion))return PotionChoiceSupport.GetSpec(simulator,potion);
+        var (effect,pile,arbitrary)=potion switch
+        {
+            GamblersBrew=>(PlanChoiceEffect.DiscardAndDraw,PileType.Hand,true),
+            Ashwater=>(PlanChoiceEffect.Exhaust,PileType.Hand,true),
+            DropletOfPrecognition=>(PlanChoiceEffect.MoveToHand,PileType.Draw,false),
+            LiquidMemories=>(PlanChoiceEffect.MoveToHandFreeThisTurn,PileType.Discard,false),
+            _=>throw new InvalidOperationException(potion.Id.Entry)
+        };
+        var cards=simulator.State.GetPlayerCombatState(recipient).GetCardPile(pile)!.Cards;
+        return new(effect,pile,arbitrary?0:1,arbitrary?cards.Count:1,cards,cards,0);
+    }
+
+    private static IReadOnlyList<PredictedCard>? ResolveRecorded(IReadOnlyList<KernelChoice>? choices,CardChoiceSpec spec,
+        Player recipient,string source)
+    {
+        var receipt=choices?.FirstOrDefault(choice=>choice.Owner==recipient.NetId && choice.Source==source &&
+            choice.Pile==spec.SourcePile && choice.Effect==spec.Effect.ToString());
+        var selected=receipt?.ResolveMenu(recipient.NetId,spec.Options.Select(c=>c.Preview).ToArray(),
+            spec.MinCount,spec.MaxCount,source);
+        return selected?.Select(card=>spec.Options.Single(option=>ReferenceEquals(option.Preview,card))).ToArray();
+    }
+
+    private static bool ApplyPotionSelection(CombatPredictionSimulator simulator,SimulatedCombatState combat,Player creator,
+        PlanChoiceEffect effect,IReadOnlyList<PredictedCard> cards)
+    {
+        if(cards.Count==0)return true;
+        switch(effect)
+        {
+            case PlanChoiceEffect.DiscardAndDraw:
+                simulator.DiscardAndDraw(cards,cards.Count);
+                break;
+            case PlanChoiceEffect.Exhaust:
+                foreach(var card in cards)
+                {
+                    simulator.Exhaust(card);
+                    if(!CombatBeamSolver.SettleReplayActionBoundary(simulator,combat))return false;
+                }
+                break;
+            case PlanChoiceEffect.MoveToHandFreeThisTurn:
+                foreach(var card in cards)card.SetToFreeThisTurn();
+                simulator.AddToPile(cards,PileType.Hand);
+                break;
+            case PlanChoiceEffect.MoveToHand:
+                simulator.AddToPile(cards,PileType.Hand);
+                break;
+            case PlanChoiceEffect.GenerateToHand:
+                var generated=cards.Select(card=>card.Clone()).ToArray();
+                foreach(var card in generated)card.SetToFreeThisTurn();
+                simulator.AddGeneratedCardsToCombat(generated,PileType.Hand,creator,CardPilePosition.Bottom,CardGenerationResultKind.Random);
+                break;
+            default:
+                throw new InvalidOperationException(effect.ToString());
+        }
+        return CombatBeamSolver.SettleReplayActionBoundary(simulator,combat);
+    }
+}
