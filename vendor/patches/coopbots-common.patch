+        CardChoiceSpec spec = new(PlanChoiceEffect.MoveToHand, PileType.Draw, 1, 1, cards, cards, 0d);
+        TurnStartChoiceRequest request = new(string.Empty, spec.Effect, spec.SourcePile, 1, spec,
