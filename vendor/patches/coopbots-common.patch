+    internal void ResolveTutor(CombatPredictionSimulator simulator, PredictedCard card, Player picker)
+    {
+        if (simulator.IsOverOrEnding || simulator.State.GetCreature(picker.Creature).IsDead)
+            return;
+
+        if (CurrentSide == MegaCrit.Sts2.Core.Combat.CombatSide.Player)
+            (_reopenedPlayerTurns ??= []).Add(picker.NetId);
+        var drawPile = simulator.State.GetPlayerCombatState(picker).DrawPile.Cards;
