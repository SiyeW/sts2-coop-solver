new file mode 100644
index 0000000000000000000000000000000000000000..d2933c8999c013485127f91882ffc1795ee535d7
--- /dev/null
+++ b/src/CoopBots.Kernel/Vendor/Engine/InCombat/Mirrors/Hooks/Card/FoolPowerHooks.cs
@@ -0,0 +1,59 @@
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Powers;
+using MegaCrit.Sts2.Core.ValueProps;
+using CoopBots.Kernel.Vendor.Engine.Common;
+
+namespace CoopBots.Kernel.Vendor.Engine.InCombat.Mirrors.Hooks.Card;
+
+internal static class FoolPowerHooks
+{
+    internal static void AfterEncore(EncorePower power, AfterCardPlayedMirrorContext c)
+    {
+        if (c.CardPlay.Player.Creature != power.Owner) return;
+        var state = c.StateStore.Get<FoolEncoreState>(power);
+        if (!state.Ongoing.Remove(c.CardPlay)) return;
+        state.Finished++;
+        ((SimulatedCombatState)c.CombatState).SetPowerDynamicVar(c.Simulator, power, "PlaysRemaining",
+            Math.Max(0, power.Amount - state.Finished));
+    }
+
+    internal static void AfterLullaby(LullabyPower power, AfterCardPlayedMirrorContext c)
+    {
+        if (c.CardPlay.Player.Creature != power.Owner || c.Simulator.IsOverOrEnding) return;
+        var combat = (SimulatedCombatState)c.CombatState;
+        if (combat.MelodyCount(c.CardPlay.Player) < 3) return;
+        var gate = c.StateStore.Get<FoolTurnTriggerState>(power);
+        if (gate.Triggered) return;
+        gate.Triggered = true;
+        c.Simulator.GainBlock(power.Owner, power.Amount, ValueProp.Unpowered);
+    }
+
+    internal static void FirstMelodyReward(PowerModel power, AfterCardPlayedMirrorContext context, bool autoPlay)
+    {
+        var player = context.CardPlay.Player;
+        if (player.Creature != power.Owner) return;
+        var combat = (SimulatedCombatState)context.CombatState;
+        int count = SimulatedCombatState.MelodyTags.Count(tag => combat.IsFirstMelodyPlay(context.CardPlay, tag)) * power.Amount;
+        if (count == 0) return;
+        if (autoPlay) context.Simulator.AutoPlayFromDrawPile(player, count, CardPilePosition.Top);
+        else context.Simulator.Draw(player, count);
+    }
+}
+
+internal sealed class FoolTurnTriggerState : IPredictionStateForkable
+{
+    public bool Triggered;
+    public object Fork(PredictionForkContext context) => MemberwiseClone();
+}
+
+internal sealed class FoolEncoreState : IPredictionStateForkable
+{
+    public int Finished;
+    public HashSet<CardPlay> Ongoing = new(ReferenceEqualityComparer.Instance);
+    public object Fork(PredictionForkContext context) => new FoolEncoreState
+    {
+        Finished = Finished,
+        Ongoing = new(Ongoing.Select(context.RemapOrSelf), ReferenceEqualityComparer.Instance)
+    };
+}
