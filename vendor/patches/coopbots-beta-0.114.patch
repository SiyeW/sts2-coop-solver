+            int generated = ((SimulatedCombatState)c.CombatState).SadnessGenerated(c.Simulator, card.Owner);
+            decimal damage = card.DynamicVars.CalculationBase.BaseValue + card.DynamicVars.ExtraDamage.BaseValue * generated;
+            c.Simulator.ExecuteAttack(DamageCmd.Attack(damage).FromCard(card, c.CardPlay).Targeting(c.Target));
+        });
+        registry.Register<WahSymphony>((card, c) =>
+        {
+            int melodies = c.OwnerState.AllCards.Count(candidate =>
+                candidate.Preview.Tags.Contains(CardTag.Cho) || candidate.Preview.Tags.Contains(CardTag.Ki));
+            decimal damage = card.DynamicVars.CalculationBase.BaseValue + card.DynamicVars.ExtraDamage.BaseValue * melodies;
+            c.Simulator.ExecuteAttack(DamageCmd.Attack(damage).FromCard(card, c.CardPlay).TargetingAllOpponents(c.CombatState));
+        });
+        registry.Register<RhythmStrike>((card, c) => c.AttackSingle(card.DynamicVars.CalculationBase.IntValue
+            + card.DynamicVars.CalculationExtra.IntValue * ((SimulatedCombatState)c.CombatState).MelodyCount(card.Owner)));
+        registry.Register<HarmonicShield>((card, c) =>
+        {
+            var variable = card.DynamicVars.CalculatedBlock;
+            decimal block = card.DynamicVars.CalculationBase.BaseValue + card.DynamicVars.CalculationExtra.BaseValue
+                * ((SimulatedCombatState)c.CombatState).MelodyCount(card.Owner);
+            c.Simulator.GainBlock(card.Owner.Creature, block, variable.Props, c.Card, c.CardPlay);
+        });
+        registry.Register<Enrapture>(Play);
+        registry.Register<SelfDeprecate>(Play);
+        registry.Register<Yoga>(Play);
+        registry.Register<Optimism>(Play);
+        OwnerPower<Compost, CompostPower>(registry, "Energy");
+        OwnerPower<CoveringFire, CoveringFirePower>(registry, "CoveringFirePower");
+        OwnerPower<Ensemble, EnsemblePower>(registry, "Cards");
+        registry.Register<ShowOff>((card, c) =>
+        {
+            var combat = (SimulatedCombatState)c.CombatState;
+            combat.ApplyPowerFromSource(typeof(AimPower), card.Owner.Creature, card.DynamicVars["AimPower"].IntValue,
+                card.Owner.Creature, card);
+            if (!c.Simulator.HasPendingChoice && !c.Simulator.IsEnding) combat.ApplyShowOff(c.Card);
