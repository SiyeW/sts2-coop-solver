+
+    private static void OwnerPower<TCard, TPower>(MethodMirrorRegistry<CardModel, CardOnPlayMirrorContext> registry, string key)
+        where TCard : CardModel where TPower : PowerModel
+        => registry.Register<TCard>((card, c) => ((SimulatedCombatState)c.CombatState).ApplyPowerFromSource(
+            typeof(TPower), card.Owner.Creature, card.DynamicVars[key].IntValue, card.Owner.Creature, card));
+
+    private static void Play(CardModel card, CardOnPlayMirrorContext c)
+    {
+        var sim = c.Simulator;
+        var combat = (SimulatedCombatState)c.CombatState;
+        var owner = card.Owner;
+        void Apply<T>(int amount, bool enemy = false) where T : PowerModel
+            => combat.ApplyPowerFromSource(typeof(T), enemy ? c.Target! : owner.Creature, amount, owner.Creature, card);
+        void Generate<T>(int count) where T : CardModel
+            => sim.CreateAndAddGeneratedCardsToCombat<T>(owner, PileType.Hand, count, owner);
+        bool Impaled() => c.Target is not null && combat.EffectivePowers().OfType<ImpaledPower>()
+            .Any(power => power.Amount > 0 && power.Owner == c.Target);
+
+        switch (card)
+        {
+            case Enrapture:
+                Apply<VigorPower>(card.DynamicVars["VigorPower"].IntValue, true);
+                if (!sim.HasPendingChoice) Apply<StretchPower>(card.DynamicVars["StretchPower"].IntValue, true);
+                break;
+            case SelfDeprecate:
+                Generate<Sadness>(card.DynamicVars["Sadness"].IntValue);
+                foreach (var ally in combat.GetTeammatesOf(owner.Creature))
+                {
+                    if (sim.HasPendingChoice) return;
+                    if (ally.Player is { } player && player != owner && sim.State.GetCreature(ally).IsAlive)
+                        sim.CreateAndAddGeneratedCardsToCombat<Joy>(player, PileType.Hand, card.DynamicVars["Joy"].IntValue, owner);
+                }
+                break;
+            case Yoga:
+                foreach (var ally in combat.GetTeammatesOf(owner.Creature).Where(ally => ally.IsPlayer && sim.State.GetCreature(ally).IsAlive))
+                {
+                    combat.ApplyPowerFromSource(typeof(StretchPower), ally, card.DynamicVars["StretchPower"].IntValue, owner.Creature, card);
+                    if (sim.HasPendingChoice) return;
+                }
+                break;
+            case Optimism:
+                var removed = c.OwnerState.Hand.Cards.Where(candidate => candidate.Preview is Sadness).ToArray();
+                foreach (var candidate in removed) { sim.Exhaust(candidate); if (sim.HasPendingChoice) return; }
+                if (removed.Length > 0) sim.Draw(owner, removed.Length);
+                break;
+            case BrightenUp:
+                Generate<Sadness>(card.DynamicVars["Sadness"].IntValue);
+                if (!sim.HasPendingChoice) Generate<Joy>(card.DynamicVars["Joy"].IntValue);
+                break;
+            case Brace:
+                for (int i = 0, count = c.Card.ResolveEnergyXValue(c.State); i < count; i++)
+                {
+                    Apply<AimPower>(card.DynamicVars["AimPower"].IntValue);
+                    if (sim.HasPendingChoice) return;
+                }
+                break;
+            case Joy:
+                sim.GainEnergy(owner, card.DynamicVars.Energy.IntValue);
+                if (!sim.HasPendingChoice) sim.Draw(owner, card.DynamicVars.Cards.IntValue);
+                break;
+            case ChoBarbs:
+                c.GainBlock(owner.Creature);
+                if (!sim.HasPendingChoice) Apply<ChoBarbsPower>(card.DynamicVars["ChoBarbsPower"].IntValue);
+                break;
+            case ChoFirm:
+            case ChoLimbs:
+                int blocks = card is ChoLimbs || c.OwnerState.Arrows.Any(arrow => arrow.IsAvailable) ? 2 : 1;
+                for (int i = 0; i < blocks; i++) { c.GainBlock(owner.Creature); if (sim.HasPendingChoice) return; }
+                break;
+            case ChoKi:
+                int stretch = combat.GetAmount<StretchPower>(owner.Creature);
+                c.GainBlock(owner.Creature);
+                if (!sim.HasPendingChoice && stretch > 0) Apply<StretchPower>(stretch);
+                break;
+            case ChoReady:
+                c.GainBlock(owner.Creature);
+                if (!sim.HasPendingChoice) Apply<AimPower>(card.DynamicVars["AimPower"].IntValue);
+                break;
+            case DeepStretch:
+                Apply<StretchPower>(card.DynamicVars["StretchPower"].IntValue);
+                if (!sim.HasPendingChoice) sim.Draw(owner, card.DynamicVars.Cards.IntValue);
+                break;
+            case DislikeYou:
+                c.AttackSingle();
+                if (!sim.HasPendingChoice) Apply<DislikeYouPower>(card.DynamicVars["DislikeYouPower"].IntValue, true);
+                break;
+            case KiHop:
+            case BowSmack:
+                bool impaled = Impaled();
+                c.AttackSingle();
+                if (sim.HasPendingChoice || !impaled) return;
+                if (card is KiHop) sim.Draw(owner, card.DynamicVars.Cards.IntValue);
+                else sim.GainEnergy(owner, card.DynamicVars.Energy.IntValue);
+                break;
+            case KiWhip:
+                c.AttackSingle();
+                if (!sim.HasPendingChoice) Apply<EnergyNextTurnPower>(card.DynamicVars.Energy.IntValue);
+                break;
+            case WahKi:
+                c.AttackSingle(card.DynamicVars.HitCount.IntValue);
+                break;
+            case KiRest:
+                Apply<EnergyNextTurnPower>(card.DynamicVars.Energy.IntValue);
+                if (!sim.HasPendingChoice && (combat.PlayedMelody(owner, CardTag.Wah) || combat.PlayedMelody(owner, CardTag.Cho)))
+                    Apply<RetainHandPower>(1);
+                break;
+            case PunchOfJoy:
+                c.AttackSingle();
+                if (sim.HasPendingChoice) return;
+                var sadness = c.OwnerState.Hand.Cards.Where(candidate => candidate.Preview is Sadness).ToList();
+                if (sadness.Count > 0)
+                {
+                    var chosen = sadness.StableShuffle(c.Rng.CombatCardSelection).Take(card.DynamicVars.Cards.IntValue).ToArray();
+                    if (!CardChoiceSupport.TransformCards(sim, chosen, CanonicalModels.Card<Joy>(), false))
+                        sim.RejectExecutionContinuation();
+                }
+                break;
+            case SorrowfulStrike:
+                c.AttackSingle();
+                if (!sim.HasPendingChoice) Generate<Sadness>(card.DynamicVars.Cards.IntValue);
+                break;
+            case WahCho:
+                c.GainBlock(owner.Creature);
+                if (!sim.HasPendingChoice) c.AttackSingle();
+                break;
+            case WahChoKi:
+                c.AttackSingle();
+                if (sim.HasPendingChoice) return;
+                c.GainBlock(owner.Creature);
+                if (!sim.HasPendingChoice) sim.Draw(owner, card.DynamicVars.Cards.IntValue);
+                break;
+            case WahSweep:
+                c.AttackAllOpponents();
+                break;
+            case WahTouch:
+                c.AttackSingle();
+                if (!sim.HasPendingChoice) Apply<VulnerablePower>(card.DynamicVars.Vulnerable.IntValue, true);
+                break;
+            case Timber:
+                var timber = sim.BeginAttackContext(c.Card, c.CardPlay);
+                bool completed = false;
+                try
+                {
+                    var hits = sim.Damage([c.Target], card.DynamicVars.Damage.BaseValue,
+                        ValueProp.Move, owner.Creature, c.Card, c.CardPlay);
+                    sim.RequireSettledArrowEffect();
+                    sim.AddAttackContextHit(timber, hits);
+                    if (hits.Any(result => result.WasTargetKilled))
+                    {
+                        var opponents = combat.GetOpponentsOf(owner.Creature).Where(sim.State.IsHittable).ToArray();
+                        var spread = sim.Damage(opponents, card.DynamicVars["OnKillDamage"].BaseValue,
+                            ValueProp.Move, owner.Creature, c.Card, c.CardPlay);
+                        sim.RequireSettledArrowEffect();
+                        sim.AddAttackContextHit(timber, spread);
+                    }
+                    completed = true;
+                }
+                finally { sim.EndAttackContext(timber, completed, recordAttack: false); }
+                break;
+            case Jest:
+                c.GainBlock(owner.Creature);
+                if (!sim.HasPendingChoice) Generate<Sadness>(card.DynamicVars.Cards.IntValue);
+                break;
+            case Nail:
+                if (!Impaled()) return;
+                c.AttackSingle();
+                if (sim.HasPendingChoice) return;
+                Apply<WeakPower>(card.DynamicVars["Power"].IntValue, true);
+                if (!sim.HasPendingChoice) Apply<VulnerablePower>(card.DynamicVars["Power"].IntValue, true);
+                break;
+            case Rummage:
+                sim.Draw(owner, card.DynamicVars.Cards.IntValue);
+                if (!sim.HasPendingChoice) Generate<Sadness>(1);
+                break;
+            case Vitriol:
+                Apply<WeakPower>(card.DynamicVars.Weak.IntValue, true);
+                if (!sim.HasPendingChoice) Generate<Sadness>(card.DynamicVars.Cards.IntValue);
+                break;
+            case Growth:
+                c.GainBlock(owner.Creature);
+                if (sim.HasPendingChoice) return;
+                var sadnessCards = c.OwnerState.Hand.Cards.Where(candidate => candidate.Preview is Sadness).ToList();
+                if (sadnessCards.Count > 0)
+                {
+                    var sad = sadnessCards.StableShuffle(c.Rng.CombatCardSelection).First();
+                    CardChoiceSupport.TransformCardToGeneratedReplacement(sim, sad, c.Card.CreateClone().MutablePreview);
+                }
+                break;
+            case Uproot:
+            case Wrest:
+                if (sim.ImpaledBy(c.Target!, owner) is null) return;
+                while (sim.ImpaledBy(c.Target!, owner) is not null)
+                { sim.RecallArrows(c.Target!, owner, c.Card); if (sim.HasPendingChoice) return; }
+                if (card is Uproot) Apply<VulnerablePower>(card.DynamicVars.Vulnerable.IntValue, true);
+                else sim.Draw(owner, card.DynamicVars.Cards.IntValue);
+                break;
+            case BlotOutTheSky:
+                var generated = ModelDb.CardPool<FoolCardPool>().GetUnlockedCards(owner.UnlockState, c.CardMultiplayerConstraint)
+                    .Where(candidate => candidate.Tags.Contains(CardTag.Shoot))
+                    .GetDistinctForCombat(owner, 1, c.Rng.CombatCardGeneration, c.CardMultiplayerConstraint);
+                sim.AddGeneratedCardsToCombat(generated.Select(candidate => candidate.SetToFreeThisTurn()).ToList(), PileType.Hand, owner);
+                break;
+            default: throw new ArgumentOutOfRangeException(nameof(card), card.GetType().FullName);
+        }
+    }
+}
