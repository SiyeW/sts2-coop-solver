+// Adapted from CombatSolver v0.51.9 (Torch1230 and contributors, MIT).
+using CoopBots.Kernel.Vendor.Engine.Common;
+using CoopBots.Kernel.Vendor.Engine.InCombat.Mirrors.Hooks.Damage;
