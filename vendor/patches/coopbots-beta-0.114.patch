diff --git a/src/CoopBots.Kernel/Vendor/Engine/InCombat/Mirrors/Cards/OnPlay/FoolArrowCardMirrors.cs b/src/CoopBots.Kernel/Vendor/Engine/InCombat/Mirrors/Cards/OnPlay/FoolArrowCardMirrors.cs
