+    private SimulatedCombatState ArrowCombat => (SimulatedCombatState)State.CombatState;
+
+    internal static int SlotIndex(IReadOnlyList<ArrowSlot> slots, ArrowSlot arrow)
+    {
+        for (int index = 0; index < slots.Count; index++)
+            if (ReferenceEquals(slots[index], arrow)) return index;
+        throw new InvalidOperationException("Impaled arrow has no slot in the owner's quiver.");
+    }
+
+    // Store indices into the applying player's quiver. Forking a player clones
+    // the quiver, so no arrow in an enemy's power can point into another fork.
+    internal void CaptureImpaledArrows(ImpaledPower target, ImpaledPower source)
+        => StateStore.GetReadOnly(target, () => new ImpaledArrowState(source.Arrows
+            .Select(arrow => SlotIndex(arrow.owner.PlayerCombatState!.Arrows, arrow))));
+
+    internal IReadOnlyList<int> ImpaledSlots(ImpaledPower power)
+        => StateStore.Peek(power, static () => new ImpaledArrowState()).Slots;
+
+    internal ImpaledPower? ImpaledBy(Creature target, Player player)
+        => ArrowCombat.EffectivePowers().OfType<ImpaledPower>()
+            .FirstOrDefault(power => power.Owner == target && power.Applier == player.Creature);
+
+    internal ArrowSlot? ShootArrow(Player player, PredictedCard source)
+    {
+        ArrowSlot? arrow = State.GetPlayerCombatState(player).Arrows.LastOrDefault(slot => slot.IsAvailable);
+        if (arrow is not null)
+            arrow.Status = ArrowStatus.Away;
+        ArrowMirrors.AfterShot(new() { Simulator = this, Player = player, Arrow = arrow, Source = source });
+        RequireSettledArrowEffect();
+        return arrow;
+    }
+
+    internal bool ShootArrowAt(Creature target, Player player, PredictedCard source, AttackCommand attack)
+    {
+        if (State.GetCreature(target).IsDead) return false;
+        ArrowSlot? arrow = ShootArrow(player, source);
+        if (HasPendingChoice || arrow is null) return false;
+        if (State.GetCreature(target).IsDead)
+        {
+            arrow.Status = ArrowStatus.Retrieved;
+            return true;
+        }
+        ExecuteAttack(attack);
+        RequireSettledArrowEffect();
+        ImpaleArrow(target, arrow, source, hookSource: null);
+        return true;
+    }
+
+    internal void ImpaleArrow(Creature target, ArrowSlot arrow, PredictedCard source, PredictedCard? hookSource)
+    {
+        ImpaledPower? power = ImpaledBy(target, arrow.owner);
+        if (power is null)
+        {
+            if (State.GetCreature(target).IsAlive && !IsEnding)
+            {
+                ArrowCombat.ApplyPowerFromSource(typeof(ImpaledPower), target, 1, arrow.owner.Creature, source.Preview);
+                power = ImpaledBy(target, arrow.owner)
+                    ?? throw new InvalidOperationException("Arrow application did not create its target state.");
+            }
+            else
+            {
+                power = (ImpaledPower)ModelDb.Power<ImpaledPower>().ToMutable();
+                power._owner = target;
+                power._applier = arrow.owner.Creature;
+            }
+        }
+
+        var slots = StateStore.Get<ImpaledArrowState>(power).Slots;
+        slots.Add(SlotIndex(State.GetPlayerCombatState(arrow.owner).Arrows, arrow));
+        ArrowMirrors.AfterImpaled(new()
+        {
+            Simulator = this, Player = arrow.owner, Arrow = arrow, Impaled = power, Source = hookSource
+        });
+        RequireSettledArrowEffect();
+        if (State.GetCreature(target).IsDead && arrow.Status == ArrowStatus.Away)
+            DislodgeAll(power, source);
+    }
+
+    internal void RecallArrows(Creature target, Player player, PredictedCard source)
+    {
+        if (ImpaledBy(target, player) is { } power)
+            DislodgeAll(power, source);
+    }
+
+    private void DislodgeAll(ImpaledPower power, PredictedCard? source)
+    {
+        while (ImpaledSlots(power).Count > 0 && !HasPendingChoice)
+            Dislodge(power, source);
+    }
+
+    private void Dislodge(ImpaledPower power, PredictedCard? source)
+    {
+        var slots = StateStore.Get<ImpaledArrowState>(power).Slots;
+        Player player = power.Applier!.Player!;
+        ArrowSlot arrow = State.GetPlayerCombatState(player).Arrows[slots[0]];
+        slots.RemoveAt(0);
+        ArrowMirrors.AfterDislodged(new()
+        {
+            Simulator = this, Player = player, Arrow = arrow, Impaled = power, Source = source
+        });
+        RequireSettledArrowEffect();
+        if (arrow.Status != ArrowStatus.Away)
+            throw new InvalidOperationException("An impaled arrow is no longer away from its owner.");
+        arrow.Status = ArrowStatus.Retrieved;
+        if (slots.Count == 0 && ArrowCombat.EffectivePowers().Contains(power))
+            ArrowCombat.SetPowerAmount(power, 0);
+    }
+
+    // An in-flight arrow must never become a settled state on a child branch.
+    internal void RequireSettledArrowEffect()
+    {
+        if (HasPendingChoice)
+            throw new InvalidOperationException("An arrow effect paused for a choice inside its resolution.");
+    }
+
+    internal void AfterImpaledDamage(ImpaledPower power, AfterDamageReceivedMirrorContext context)
+    {
+        if (context.Target != power.Owner || context.Dealer is null
+            || context.Source?.Preview.Owner.Creature != power.Applier || !context.Props.IsPoweredAttack())
+            return;
+        power = ArrowCombat.MutableImpaledPower(power);
+        if (--power.HitCounter > 0) return;
+        power.HitCounter = 3;
+        Dislodge(power, context.Source);
+    }
+
+    internal void AfterImpaledDeath(ImpaledPower power, AfterDeathMirrorContext context)
+    {
+        if (context.Creature == power.Owner && power.Applier is { } applier && !State.GetCreature(applier).IsDead)
+            DislodgeAll(power, context.Source);
+    }
+}
+
+internal sealed class ImpaledArrowState(IEnumerable<int>? slots = null) : IPredictionStateForkable
+{
+    // PredictionStateStore constructs the empty state when applying a new power.
+    public ImpaledArrowState() : this(null) { }
+    public List<int> Slots { get; } = slots?.ToList() ?? [];
+    public object Fork(PredictionForkContext context) => new ImpaledArrowState(Slots);
+}
