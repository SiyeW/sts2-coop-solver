+        var active = patches.Prefixes.Concat(patches.Postfixes).Concat(patches.Transpilers).Concat(patches.Finalizers).ToArray();
+        detail = string.Join(",", active.Select(p => p.PatchMethod.DeclaringType?.FullName + "." + p.PatchMethod.Name));
+        return patches.Transpilers.Count == 0 && patches.Finalizers.Count == 0 && RitsuEmptyCapabilityFastPath.CanSkip(card)
+            && active.All(p => p.PatchMethod.DeclaringType?.Assembly == typeof(ModelCapabilities).Assembly);
+    }
