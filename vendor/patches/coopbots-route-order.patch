+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Localization.DynamicVars;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Powers;
+
+namespace CoopBots.Kernel;
+
+public sealed partial class KernelSession
+{
+    // Experimental contract for a complete segment of owner-local plays.
+    // The existing effect implementation supplies the card shape. Any other
+    // implementation, active hook, selection, or changing roster is opaque.
+    internal sealed record OrderEffect(ulong Owner, Creature? SharedTarget, int Add);
+    private const MirroredHookMask DuringLocalPlay = MirroredHookMask.AfterAutoPostPlayPhaseEntered |
+        MirroredHookMask.BeforeBlockGained | MirroredHookMask.AfterBlockGained | MirroredHookMask.ModifyBlockAdditive |
+        MirroredHookMask.ModifyBlockMultiplicative | MirroredHookMask.AfterModifyingBlockAmount |
+        MirroredHookMask.BeforeCardPlayed | MirroredHookMask.AfterCardPlayed | MirroredHookMask.AfterCardPlayedLate |
+        MirroredHookMask.ShouldPlay | MirroredHookMask.TryModifyEnergyCostInCombat |
+        MirroredHookMask.TryModifyEnergyCostInCombatLate | MirroredHookMask.TryModifyStarCost |
+        MirroredHookMask.TryModifyKeywordsInCombat | MirroredHookMask.AfterCardExhausted |
+        MirroredHookMask.ModifyCardPlayCount | MirroredHookMask.AfterModifyingCardPlayCount |
+        MirroredHookMask.ModifyCardPlayResultLocation | MirroredHookMask.AfterModifyingCardPlayResultLocation;
+
+    internal bool SupportsLocalRouteOrder(KernelTeamSearch.Action action)
+    {
+        using var isolation = SimulationNotificationIsolation.Enter();
+        // If one living actor still has not ended after all recorded moves,
+        // the earlier end actions only set their own readiness flags.
+        if (action.EndTurn)
+            return (action.TurnStartChoices is null || action.TurnStartChoices is { } end &&
+                    end.FromRound == end.ToRound && end.Choices.Count == 0 && end.OwnersTurnNumbers.Count == 0)
+                && CanAct(action.Player) && Combat.Players.Count(player => CanAct(player)) > 1;
+        return InspectLocalOrderEffect(action, out _) is not null;
+    }
+
+    internal OrderEffect? InspectLocalOrderEffect(KernelTeamSearch.Action action, out string reason)
+    {
+        reason = "action";
+        if (action.Card is null || action.Target is not null || action.EndTurn || action.Potion is not null ||
+            action.Choices is {Count:>0} || !CanAct(action.Player) || EnemyPhaseCompleted || HasTerminal) return null;
+        var card = simulator.State.FindCard(action.Card)?.Preview;
+        reason = "body";
+        if (card is null || card.GetType().Assembly != typeof(CardModel).Assembly ||
+            !ReferenceEquals(card.Owner, action.Player) || card.TargetType != TargetType.Self ||
+            card.Affliction is not null || card.Enchantment is not null || card.IsDupe || card.ExhaustOnNextPlay ||
+            !CardOnPlayMirrors.IsDirectBlock(card) || CardEffectSpecRegistry.Contains(card) ||
+            CardOnPlayCompensationCatalog.Contains(card) ||
+            card.DynamicVars.TryGetValue("CalculatedBlock", out _) ||
+            !card.DynamicVars.TryGetValue("Block", out var block) || block is not BlockVar) return null;
+        var type = card.GetType();
+        var implementation = AdaptedCardOnPlayMirrors.ResolveOnPlay(type);
+        reason = "patched-on-play";
+        if (implementation is null || Patched(implementation)) return null;
+        reason = "playability";
+        if (!CardIsPlayableMirrors.HasDefaultPlayability(card, out var playability))
+        { reason += ":" + playability; return null; }
+
+        reason = "environment";
+        if (Combat.AdaptedOnPlay is not null || Combat.Modifiers.Count > 0 ||
+            LastActionHadEnvironmentalRisk || !CanFork || Combat.HasPendingChoice || Combat.PlayerTurnEndRequested ||
+            simulator.State.CombatState.Enemies.Any(enemy => simulator.State.GetCreature(enemy).IsDead)) return null;
+
+        Creature? target = null;
+        int amount = 0;
+        EnragePower? enrage = null;
+        foreach (var power in Combat.EffectivePowers())
+        {
+            if (power is EnragePower stacks && enrage is null && stacks.Amount > 0 && !stacks.Owner.IsPlayer)
+                enrage = stacks;
+            else if (power is not StrengthPower)
+            { reason = "power:" + power.Id.Entry; return null; }
+        }
+        if (enrage is not null && AfterCardPlayedMirrors.GetEnrageIncrement(enrage, card) is int delta)
+        {
+            // Existing Enrage handler adds fixed Strength with the enemy as
+            // source. An existing stack avoids power-creation order effects.
+            if (!Combat.EffectivePowers().Any(p => p is StrengthPower && ReferenceEquals(p.Owner, enrage.Owner) && p.Amount > 0))
+            { reason = "new-stack"; return null; }
+            target = enrage.Owner;
+            amount = delta;
+            if ((long)Power<StrengthPower>(target) + amount > int.MaxValue)
+            { reason = "amount"; return null; }
+        }
+
+        foreach (var listener in simulator.State.IterateHookListeners())
+        {
+            var hooks = MirroredHookListenerFilter.MaskFor(listener.GetType()) & DuringLocalPlay;
+            if (ReferenceEquals(listener, enrage) || AfterCardPlayedMirrors.IsIgnored(listener))
+                hooks &= ~MirroredHookMask.AfterCardPlayed;
+            if (AfterCardPlayedMirrors.IsLateIgnored(listener))
+                hooks &= ~MirroredHookMask.AfterCardPlayedLate;
+            if (ModifyBlockMultiplicativeMirrors.IsIdentityForPlayerBlock(listener, action.Player.Creature))
+                hooks &= ~MirroredHookMask.ModifyBlockMultiplicative;
+            if (hooks != 0)
+            { reason = "listener:" + listener.Id.Entry + ":" + hooks; return null; }
+        }
+
+        reason = "";
+        return new(action.Player.NetId, target, amount);
+        static bool Patched(MethodBase method) => Harmony.GetPatchInfo(method) is { Owners.Count:>0 };
+    }
+}
